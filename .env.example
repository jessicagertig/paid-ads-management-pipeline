# Paid Ads Management Pipeline - environment config
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# Google Ads API
# Developer token comes from the API Center of a Google Ads manager account.
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth2 installed-app client, created in Google Cloud Console.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Minted once by scripts/generate_refresh_token.py
GOOGLE_ADS_REFRESH_TOKEN=
# 10-digit account id, no hyphens. The account running the campaigns.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_USE_PROTO_PLUS=True

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_PAID_ADS_CHANNEL_ID=

# Anthropic (classifier). Key is scoped to this project only.
ANTHROPIC_API_KEY=sk-ant-
